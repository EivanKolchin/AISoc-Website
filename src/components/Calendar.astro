---
// The interactive calendar. "home" shows this week and can expand to the month, with
// the chosen event underneath. "events" shows the month with the chosen event beside it.
// The first draw happens here at build time; src/scripts/site.ts takes over in the
// browser so today's date, the arrows and the event chips all work.
import eventsData from '../data/events.json';
import { type EventItem, startOfDay, upcoming } from '../lib/events';
import { afterWeekLine, calendarTitle, renderDetail, renderGrid } from '../lib/calendar';

interface Props {
  mode: 'home' | 'events';
}

const { mode } = Astro.props;
const events = eventsData as EventItem[];
const now = new Date();
const today = startOfDay(now);
const view = mode === 'home' ? 'week' : 'month';
const selected = upcoming(events, now)[0] ?? null;
const title = calendarTitle(view, today, today);
const grid = renderGrid(view, today, events, selected?.id ?? null, today);
const detail = renderDetail(selected, mode === 'home' ? 'row' : 'stack', now, mode === 'home' ? 'h3' : 'h2');
const after = afterWeekLine(events, today);
const unit = view;
---

{
  mode === 'home' && (
    <section data-calendar data-mode="home" data-view="week" aria-labelledby="cal-title">
      <div class="cal-head">
        <div class="cal-head-l">
          <h2 class="h-sec" id="cal-title" data-cal-title aria-live="polite">
            {title}
          </h2>
          <div class="cal-nav">
            <button class="rnd" type="button" data-cal-prev aria-label={`Previous ${unit}`}>
              <svg aria-hidden="true" viewBox="0 0 20 20">
                <path d="M12 4l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button class="rnd" type="button" data-cal-next aria-label={`Next ${unit}`}>
              <svg aria-hidden="true" viewBox="0 0 20 20">
                <path d="M8 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>
        <button class="btn btn-s" type="button" data-cal-toggle aria-expanded="false" aria-controls="cal-grid">
          <svg aria-hidden="true" viewBox="0 0 20 20">
            <rect x="2.5" y="3.5" width="15" height="13" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M2.5 8h15M7.5 8v8.5M12.5 8v8.5M2.5 12.2h15" fill="none" stroke="currentColor" stroke-width="1.4" />
          </svg>
          <span data-cal-toggle-label>Show the whole month</span>
        </button>
      </div>
      <div class="card cal-card">
        <div class="cal-scroll" id="cal-grid" data-cal-grid role="group" aria-label="Calendar" tabindex="0" set:html={grid} />
        <div class="cal-detail" data-cal-detail aria-live="polite" set:html={detail} />
      </div>
      <p class="cal-foot">
        <span data-cal-after>{after}</span>{' '}<a class="lnk" href="/events">Full calendar and past events</a>, or{' '}<a class="lnk" href="/calendar.ics" data-subscribe>subscribe in your calendar app</a>.
      </p>
    </section>
  )
}

{
  mode === 'events' && (
    <div class="hub" data-calendar data-mode="events" data-view="month">
      <section class="card cal-card" aria-label="Month calendar">
        <div class="cal-head cal-head--card">
          <h2 data-cal-title aria-live="polite">
            {title}
          </h2>
          <div class="cal-nav">
            <button class="rnd" type="button" data-cal-prev aria-label={`Previous ${unit}`}>
              <svg aria-hidden="true" viewBox="0 0 20 20">
                <path d="M12 4l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button class="rnd" type="button" data-cal-next aria-label={`Next ${unit}`}>
              <svg aria-hidden="true" viewBox="0 0 20 20">
                <path d="M8 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>
        <div class="cal-scroll" data-cal-grid role="group" aria-label="Calendar" tabindex="0" set:html={grid} />
      </section>
      <aside data-cal-detail aria-live="polite" aria-label="Selected event" set:html={detail} />
    </div>
  )
}
