---
// Line art for the project panels. Add a new drawing here, give it a name, then use
// that name as "plate" in src/data/projects.json.
interface Props {
  kind: string;
}

const { kind } = Astro.props;
const hours = Array.from({ length: 48 }, (_, i) => 48 + i * 6);
---

{
  kind === 'tokens' && (
    <svg aria-hidden="true" viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke="#F4F4F5" stroke-opacity=".3" stroke-width="1.3">
        <rect x="48" y="52" width="74" height="20" rx="5" />
        <rect x="130" y="52" width="42" height="20" rx="5" />
        <rect x="180" y="52" width="98" height="20" rx="5" />
        <rect x="286" y="52" width="56" height="20" rx="5" />
        <rect x="350" y="52" width="84" height="20" rx="5" />
        <rect x="442" y="52" width="38" height="20" rx="5" />
        <rect x="488" y="52" width="104" height="20" rx="5" />
        <rect x="48" y="86" width="46" height="20" rx="5" />
        <rect x="102" y="86" width="112" height="20" rx="5" />
        <rect x="222" y="86" width="60" height="20" rx="5" />
        <rect x="386" y="86" width="48" height="20" rx="5" />
        <rect x="442" y="86" width="92" height="20" rx="5" />
        <rect x="542" y="86" width="50" height="20" rx="5" />
        <rect x="48" y="120" width="90" height="20" rx="5" />
        <rect x="146" y="120" width="52" height="20" rx="5" />
        <rect x="206" y="120" width="76" height="20" rx="5" />
        <rect x="290" y="120" width="40" height="20" rx="5" />
        <rect x="338" y="120" width="120" height="20" rx="5" />
        <rect x="536" y="120" width="56" height="20" rx="5" />
        <rect x="48" y="154" width="58" height="20" rx="5" />
        <rect x="206" y="154" width="44" height="20" rx="5" />
        <rect x="258" y="154" width="104" height="20" rx="5" />
        <rect x="370" y="154" width="66" height="20" rx="5" />
        <rect x="444" y="154" width="48" height="20" rx="5" />
        <rect x="500" y="154" width="92" height="20" rx="5" />
      </g>
      <g fill="currentColor">
        <rect x="290" y="86" width="88" height="20" rx="5" />
        <rect x="466" y="120" width="62" height="20" rx="5" />
        <rect x="114" y="154" width="84" height="20" rx="5" />
      </g>
    </svg>
  )
}

{
  kind === 'hours' && (
    <svg aria-hidden="true" viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice">
      <text
        x="40"
        y="292"
        font-family="'Wix Madefor Display', sans-serif"
        font-weight="700"
        font-size="300"
        letter-spacing="-16"
        fill="none"
        stroke="#F4F4F5"
        stroke-opacity=".5"
        stroke-width="1.6"
      >
        48
      </text>
      <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
        {hours.map((x) => <line x1={x} y1="330" x2={x} y2="352" />)}
      </g>
    </svg>
  )
}

{
  kind === 'face' && (
    <svg aria-hidden="true" viewBox="0 0 240 240">
      <circle cx="120" cy="112" r="66" fill="none" stroke="#F4F4F5" stroke-opacity=".5" stroke-width="1.5" />
      <g stroke="#F4F4F5" stroke-width="2.4" stroke-linecap="round">
        <line x1="88" y1="100" x2="108" y2="102" />
        <line x1="132" y1="102" x2="152" y2="100" />
        <line x1="102" y1="140" x2="138" y2="140" />
      </g>
      <g fill="currentColor">
        <circle cx="88" cy="100" r="3.4" />
        <circle cx="108" cy="102" r="3.4" />
        <circle cx="132" cy="102" r="3.4" />
        <circle cx="152" cy="100" r="3.4" />
        <circle cx="102" cy="140" r="3.4" />
        <circle cx="138" cy="140" r="3.4" />
        <circle cx="120" cy="120" r="3.4" />
        <circle cx="120" cy="46" r="3.4" />
        <circle cx="54" cy="112" r="3.4" />
        <circle cx="186" cy="112" r="3.4" />
        <circle cx="120" cy="178" r="3.4" />
      </g>
    </svg>
  )
}

{
  kind === 'stroke' && (
    <svg aria-hidden="true" viewBox="0 0 240 240">
      <path d="M44 158 C62 74 104 66 126 122 S178 184 204 84" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
      <circle cx="204" cy="84" r="9" fill="#F4F4F5" />
      <circle cx="204" cy="84" r="18" fill="none" stroke="#F4F4F5" stroke-opacity=".4" stroke-width="1.3" />
    </svg>
  )
}
