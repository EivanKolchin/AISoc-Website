---
// The society's community links as see-through glyph badges. Links left empty or set to
// "#" in site.json are left out.
import site from '../data/site.json';
import { SOCIAL_ICONS } from '../lib/icons';
import { hasLink } from '../lib/events';

interface Props {
  /** "glass" blurs whatever is behind it (use over a photo). */
  tone?: 'plain' | 'glass';
  /** Only the links ticked "Show at the top of the home page" in the dashboard. */
  heroOnly?: boolean;
  class?: string;
}

const { tone = 'plain', heroOnly = false, class: className } = Astro.props;
const links = site.social.filter((item) => hasLink(item.url) && SOCIAL_ICONS[item.id] && (!heroOnly || item.hero));
const label = (id: string, name: string) => (id === 'discord' ? `${name}, ${site.stats.discordMembers} members` : name);
---

<ul class:list={['socials', `socials--${tone}`, className]}>
  {
    links.map((item) => (
      <li>
        <a class="sb" href={item.url} aria-label={label(item.id, item.label)} title={label(item.id, item.label)}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path fill="currentColor" d={SOCIAL_ICONS[item.id]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
