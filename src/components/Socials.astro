---
// The society's community links as see-through glyph badges, shown in the footer.
// Links left empty or set to "#" in site.json are left out.
import site from '../data/site.json';
import { SOCIAL_ICONS } from '../lib/icons';
import { hasLink } from '../lib/events';

// The numbers from Society details, shown when you hover over a badge ("Instagram, 1,602 followers").
const COUNTS: Record<string, [field: string, noun: string]> = {
  discord: ['discordMembers', 'members'],
  instagram: ['instagramFollowers', 'followers'],
  facebook: ['facebookFollowers', 'followers'],
  whatsapp: ['whatsappMembers', 'members'],
};
const stats = site.stats as unknown as Record<string, number | null | undefined>;

const links = site.social.filter((item) => hasLink(item.url) && SOCIAL_ICONS[item.id]);
const label = (id: string, name: string) => {
  const [field, noun] = COUNTS[id] ?? [];
  const count = field ? stats[field] : null;
  return typeof count === 'number' && count > 0 ? `${name}, ${count.toLocaleString('en-GB')} ${noun}` : name;
};
---

<ul class="socials">
  {
    links.map((item) => (
      <li>
        <a class="sb" href={item.url} aria-label={label(item.id, item.label)} title={label(item.id, item.label)}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path fill="currentColor" d={SOCIAL_ICONS[item.id]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
