---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  /** Page name for the browser tab. Leave out on the home page. */
  title?: string;
  description?: string;
  /** Home page: the header sits over the photo, and the page lays out its own sections. */
  home?: boolean;
  /** Inner page that opens with a photo hero (.page-hero): the header sits over it. */
  hero?: boolean;
}

const { title, description = site.tagline, home = false, hero = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.university}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0e12" />
    <link rel="icon" type="image/png" href="/logo-mark.png" />
    <link rel="alternate" type="text/calendar" title={`${site.name} events`} href="/calendar.ics" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header over={home || hero} />
    <main id="main" class:list={[{ main: !home }]}>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
