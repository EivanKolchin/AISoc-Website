---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <div class="lost">
    <h1 class="h-page">Nothing at this address</h1>
    <p>The page may have moved, or the link may be out of date. The events calendar and the home page are the best places to start again.</p>
    <div class="actions">
      <a class="btn btn-p" href="/">Home</a>
      <a class="btn btn-o" href="/events">Events</a>
    </div>
  </div>
</Base>
