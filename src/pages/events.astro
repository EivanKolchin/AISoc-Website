---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/nextbar.css';
import { sitePhoto } from '../lib/photos';
import Calendar from '../components/Calendar.astro';
import { SOCIAL_ICONS } from '../lib/icons';
import site from '../data/site.json';
import { allEvents } from '../lib/event-data';
import workshops from '../data/workshops.json';
import { type EventItem, capitalise, numberWord, past, upcoming } from '../lib/events';
import { renderEventList, renderNextEvent } from '../lib/calendar';

const events = allEvents;
const now = new Date();
const comingUp = upcoming(events, now);
const earlier = past(events, now);
const slot = site.workshopSlot;
const yearCount = workshops.years.length;
const slotLine = `Workshops run every ${slot.day} at ${slot.start} in ${slot.room}.`;
---

<Base hero title="Events" description={`Talks, workshops and hackathons from ${site.name}. Workshops run every ${slot.day} at ${slot.start}.`}>
  <section class="page-hero on-dark" aria-labelledby="events-h">
    <Image class="page-hero-photo" src={sitePhoto('hero-events.jpg')} alt="" widths={[720, 1080, 1440]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="page-hero-shade" aria-hidden="true"></div>
    <div class="page-hero-inner">
      <h1 id="events-h">Events</h1>
      <p>Talks, workshops, socials and hackathons. Everything is free for members, and workshops run every {slot.day} at {slot.start} in {slot.room}.</p>
      <div class="nextbar" aria-label="Next event" role="group" data-next-event data-slot={slotLine} set:html={renderNextEvent(comingUp[0] ?? null, now, slotLine)} />
    </div>
  </section>

  <div class="sec-head cal-sec-head">
    <h2 class="h-sec">Calendar</h2>
    <div class="page-head-tools">
      <div class="segs" role="group" aria-label="View">
        <button class="seg" type="button" data-view-btn="calendar" aria-pressed="true">Calendar</button>
        <button class="seg" type="button" data-view-btn="list" aria-pressed="false">List</button>
      </div>
      <a class="btn btn-o" href="/calendar.ics" data-subscribe>Subscribe</a>
    </div>
  </div>

  <div class="block" data-view-panel="calendar">
    <Calendar mode="events" />
  </div>

  <section class="block list-sec" aria-labelledby="coming-h">
    <div class="list-sec-head">
      <h2 class="h-sec" id="coming-h">Coming up</h2>
      <p>Free for members. Add any of them to your calendar.</p>
      <a class="btn btn-g" href="/calendar.ics" data-subscribe>Subscribe to all</a>
    </div>
    <div class="dl" data-event-list="upcoming" set:html={renderEventList(comingUp, now, 'upcoming')} />
  </section>

  <section class="block" id="workshops" aria-labelledby="workshops-h">
    <h2 class="h-sec" id="workshops-h">Workshops</h2>
    <p class="sec-intro">{workshops.intro}</p>
    <div class="two">
      <section class="card slot" aria-labelledby="slot-h">
        <h3 id="slot-h">{slot.day}s, {slot.start} to {slot.end}</h3>
        <dl class="ruled">
          <dt>Where</dt>
          <dd>{slot.room}, {slot.campus}</dd>
          <dt>Bring</dt>
          <dd>{slot.bring}</dd>
          <dt>Cost</dt>
          <dd>{slot.cost}</dd>
        </dl>
        <div class="actions">
          <a class="btn btn-o btn-susu" href={site.membership.url}><img class="btn-susu-mark" src="/brand/susu-mark-white.png" alt="" width="27" height="23" loading="lazy" /><span>Membership on SUSU</span></a>
        </div>
      </section>

      <section aria-labelledby="path-h">
        <h3 class="h-sub" id="path-h" style="margin-bottom: 18px">New to this?</h3>
        <ol class="steps">
          {
            workshops.path.map((step) => (
              <li>
                <div>
                  <strong>{step.title}</strong>
                  <span>{step.text}</span>
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </section>

  <section class="block" id="library" aria-labelledby="library-h">
    <div class="sec-head">
      <h2 class="h-sec" id="library-h">{capitalise(numberWord(yearCount))} years of workshop material</h2>
      <a class="gh-btn gh-btn--solid" href="https://github.com/aisoc">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={SOCIAL_ICONS.github} /></svg>
        github.com/aisoc
      </a>
    </div>
    <div class="years">
      {
        workshops.years.map((year) => (
          <a class="year" href={year.repo}>
            <span class="year-name">{year.label}</span>
            <span class="year-topics">{year.topics.length ? year.topics.join(', ') : "Notebooks and slides from that year's workshops."}</span>
            <span class="gh-btn">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={SOCIAL_ICONS.github} /></svg>
              Open on GitHub
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="block block--last list-sec" id="past" aria-labelledby="past-h">
    <div class="list-sec-head">
      <h2 class="h-sec" id="past-h">Past events</h2>
      <p>What we have run so far this year.</p>
      <a class="btn btn-g" href="/gallery">See the photos</a>
    </div>
    <div class="dl" data-event-list="past" set:html={renderEventList(earlier, now, 'past')} />
  </section>
</Base>
