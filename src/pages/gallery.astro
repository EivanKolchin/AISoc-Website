---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import gallery from '../data/gallery.json';
import { galleryEvents, galleryPhotos } from '../lib/photos';

// A larger copy of each photo for the lightbox.
const photos = await Promise.all(
  galleryPhotos.map(async (item) => ({
    ...item,
    full: (await getImage({ src: item.image, width: 1600, format: 'webp' })).src,
    place: item.eventInfo ? [item.eventInfo.when, item.eventInfo.where].filter(Boolean).join(', ') : '',
  })),
);
const usedEvents = galleryEvents.filter((ev) => photos.some((p) => p.event === ev.id));
---

<Base title="Gallery" description={gallery.intro}>
  <div class="page-head">
    <div class="page-head-text">
      <h1 class="h-page">Gallery</h1>
      <p>{gallery.intro}</p>
    </div>
  </div>

  <div class="segs filters" role="group" aria-label="Show photos from">
    <button class="seg" type="button" data-filter="all" aria-pressed="true">All <span>{photos.length}</span></button>
    {
      usedEvents.map((ev) => (
        <button class="seg" type="button" data-filter={ev.id} aria-pressed="false">
          {ev.name} <span>{photos.filter((p) => p.event === ev.id).length}</span>
        </button>
      ))
    }
  </div>

  <ul class="gallery block block--last" data-gallery>
    {
      photos.map((item, i) => (
        <li class:list={['shot', { 'shot--wide': i % 7 === 0 }]} data-event={item.event}>
          <button
            class="shot-btn"
            type="button"
            data-full={item.full}
            data-alt={item.alt}
            data-event-name={item.eventInfo?.name ?? ''}
            data-place={item.place}
            data-link={item.eventInfo?.link ?? ''}
            aria-label={`Open: ${item.alt}`}
          >
            <Image
              src={item.image}
              alt={item.alt}
              widths={[480, 720, 1080]}
              sizes={i % 7 === 0 ? '(max-width: 980px) 100vw, 66vw' : '(max-width: 980px) 100vw, 33vw'}
              loading={i < 3 ? 'eager' : 'lazy'}
            />
            {item.eventInfo && <span class="shot-tag">{item.eventInfo.name}</span>}
          </button>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox on-dark" data-lightbox aria-label="Photo">
    <figure>
      <img data-lb-img alt="" />
      <figcaption>
        <span class="lb-event" data-lb-event></span>
        <span class="lb-place" data-lb-place></span>
        <span class="lb-alt" data-lb-alt></span>
        <a class="lb-link" data-lb-link href="/sotonship">More about this event</a>
      </figcaption>
    </figure>
    <button class="lb-btn lb-prev" type="button" data-lb-prev aria-label="Previous photo">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button class="lb-btn lb-next" type="button" data-lb-next aria-label="Next photo">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <form method="dialog">
      <button class="lb-btn lb-close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </form>
  </dialog>
</Base>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const buttons = () => [...document.querySelectorAll<HTMLButtonElement>('.shot:not([hidden]) .shot-btn')];
  let current = 0;

  function show(index: number) {
    const list = buttons();
    if (!lightbox || !list.length) return;
    current = (index + list.length) % list.length;
    const b = list[current];
    const img = lightbox.querySelector<HTMLImageElement>('[data-lb-img]')!;
    img.src = b.dataset.full ?? '';
    img.alt = b.dataset.alt ?? '';
    lightbox.querySelector('[data-lb-event]')!.textContent = b.dataset.eventName ?? '';
    lightbox.querySelector('[data-lb-place]')!.textContent = b.dataset.place ?? '';
    lightbox.querySelector('[data-lb-alt]')!.textContent = b.dataset.alt ?? '';
    const link = lightbox.querySelector<HTMLAnchorElement>('[data-lb-link]')!;
    link.hidden = !b.dataset.link;
    link.href = b.dataset.link || '#';
    link.textContent = b.dataset.link === '/sotonship' ? 'More about our hackathons' : 'See upcoming events';
    if (!lightbox.open) lightbox.showModal();
  }

  document.querySelectorAll<HTMLButtonElement>('.shot-btn').forEach((b) => {
    b.addEventListener('click', () => show(buttons().indexOf(b)));
  });
  lightbox?.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
  lightbox?.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
  lightbox?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });

  // Filter by event.
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  filters.forEach((f) => {
    f.addEventListener('click', () => {
      const id = f.dataset.filter;
      filters.forEach((o) => o.setAttribute('aria-pressed', String(o === f)));
      document.querySelectorAll<HTMLElement>('.shot').forEach((shot) => {
        shot.hidden = id !== 'all' && shot.dataset.event !== id;
      });
      document.querySelector('[data-gallery]')?.classList.toggle('filtered', id !== 'all');
    });
  });
</script>

<style>
  .filters {
    display: inline-flex;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .filters span {
    margin-left: 4px;
    color: var(--muted);
    font-weight: 500;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .shot--wide {
    grid-column: span 2;
    grid-row: span 2;
  }

  .gallery.filtered .shot--wide {
    grid-column: auto;
    grid-row: auto;
  }

  .shot-btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface2);
    cursor: zoom-in;
  }

  .shot-btn img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .shot-tag {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 6px 10px;
    border-radius: 8px;
    background: rgba(11, 14, 18, 0.62);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .shot-btn img,
    .shot-tag {
      transition:
        transform 0.35s ease-out,
        opacity 0.2s ease-out;
    }

    .shot-btn:hover img,
    .shot-btn:focus-visible img {
      transform: scale(1.04);
    }
  }

  .shot-btn:hover .shot-tag,
  .shot-btn:focus-visible .shot-tag {
    opacity: 1;
  }

  .shot-btn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .lightbox {
    width: min(1180px, calc(100% - 32px));
    max-height: calc(100% - 32px);
    padding: 0;
    border: 0;
    border-radius: 18px;
    background: #0b0e12;
    color: #f4f4f5;
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgba(5, 8, 12, 0.82);
  }

  .lightbox figure {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    margin: 0;
  }

  .lightbox img {
    display: block;
    width: 100%;
    height: min(78vh, 760px);
    object-fit: contain;
    background: #000;
  }

  .lightbox figcaption {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 72px 28px 28px;
  }

  .lb-event {
    font-size: 24px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .lb-place {
    color: #a6a8ae;
  }

  .lb-alt {
    margin-top: 10px;
    font-size: 17px;
    line-height: 1.5;
    color: #d6d7db;
  }

  .lb-link {
    margin-top: auto;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    cursor: pointer;
  }

  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lb-close {
    top: 14px;
    right: 14px;
  }

  .lb-prev,
  .lb-next {
    top: calc(min(78vh, 760px) / 2 - 22px);
  }

  .lb-prev {
    left: 14px;
  }

  .lb-next {
    right: calc(300px + 14px);
  }

  @media (max-width: 980px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lightbox figure {
      grid-template-columns: minmax(0, 1fr);
    }

    .lightbox img {
      height: min(56vh, 520px);
    }

    .lightbox figcaption {
      padding: 20px 22px 24px;
    }

    .lb-prev,
    .lb-next {
      top: calc(min(56vh, 520px) / 2 - 22px);
    }

    .lb-next {
      right: 14px;
    }
  }

  @media (max-width: 560px) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }

    .shot--wide {
      grid-column: auto;
      grid-row: auto;
    }

    .shot-tag {
      opacity: 1;
    }
  }
</style>
